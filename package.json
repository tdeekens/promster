{
  "name": "promster",
  "private": true,
  "description": "Monorepository for promster and its projects e.g. metrics, hapi and express",
  "keywords": [
    "continousdelivery",
    "devops",
    "metrics",
    "monitoring",
    "prometheus"
  ],
  "homepage": "https://github.com/tdeekens/promster#readme",
  "bugs": {
    "url": "https://github.com/tdeekens/promster/issues"
  },
  "author": "Tobias Deekens <nerd@tdeekens.name>",
  "scripts": {
    "auth": "npm_config_registry=https://registry.npmjs.org npm whoami",
    "build": "pnpm pipeline build --full",
    "dev": "pnpm -r --parallel dev",
    "changeset:version-and-format": "changeset version && pnpm format && pnpm install --no-frozen-lockfile",
    "changeset": "changeset",
    "check-types": "pnpm pipeline check-types --full",
    "check-exports": "pnpm pipeline check-exports --full",
    "clean": "manypkg exec rm -rf dist .turbo && rm -rf .turbo",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prerelease": "pnpm auth && pnpm build",
    "release": "changeset publish",
    "setup": "husky install && manypkg check && check-node-version --package --print",
    "test:coverage": "vitest run --coverage",
    "test:report": "vitest run --reporter=junit --outputFile=junit.xml",
    "test": "pnpm pipeline test --full"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@babel/preset-typescript": "8.0.1",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@manypkg/cli": "0.25.1",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@vitest/coverage-v8": "5.0.2",
    "check-node-version": "4.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11",
    "pnpm": ">=12.4"
  },
  "packageManager": "pnpm@12.6.0"
}
