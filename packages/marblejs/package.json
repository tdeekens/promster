{
  "name": "@promster/marblejs",
  "version": "16.0.0",
  "description": "MarbleJs server integrations of promster",
  "keywords": [
    "continousdelivery",
    "metrics",
    "prometheus"
  ],
  "homepage": "https://github.com/tdeekens/promster#readme",
  "bugs": {
    "url": "https://github.com/tdeekens/promster/issues"
  },
  "license": "MIT",
  "author": "Lukas Sulik <l.nuzky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/tdeekens/promster.git",
    "directory": "packages/marblejs"
  },
  "files": [
    "readme.md",
    "package.json",
    "LICENSE",
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@promster/metrics": "workspace:*",
    "merge-options": "catalog:",
    "rxjs": "^7.8.1",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@marblejs/core": "4.1.0",
    "@marblejs/http": "4.1.0",
    "@promster/server": "workspace:*",
    "@promster/tsconfig": "workspace:*",
    "@promster/tsdown-config": "workspace:*",
    "@promster/types": "workspace:*",
    "fp-ts": "2.16.11",
    "parse-prometheus-text-format": "catalog:",
    "tsdown": "catalog:"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=8"
  }
}
